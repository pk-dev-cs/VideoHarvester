<Window x:Class="VideoHarvester.Views.AppUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VideoHarvester.Localization"
        xmlns:views="clr-namespace:VideoHarvester.Views"
        Language="{Binding Culture.IetfLanguageTag, ConverterCulture=en-US, Source={x:Static loc:LocalizationManager.Current}}"
        Title="{loc:Text Updates_Title}" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#151922" Foreground="#F7F8FA" FontFamily="Segoe UI Variable Text, Segoe UI">
    <views:UpdateNotification Margin="16,0,16,16" />
</Window>
