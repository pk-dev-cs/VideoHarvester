<UserControl x:Class="VideoHarvester.Views.UpdateNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VideoHarvester.Localization"
             xmlns:converters="clr-namespace:VideoHarvester.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideoHarvester;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="UpdateVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Margin="0,12,0,0" Padding="12" Background="#202735" CornerRadius="6"
            Visibility="{Binding IsPanelVisible, Converter={StaticResource UpdateVisibilityConverter}}">
        <StackPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="#F7F8FA" />
            <ProgressBar Height="5" Margin="0,8,0,0" Maximum="100" Value="{Binding DownloadProgress}"
                         Visibility="{Binding IsDownloading, Converter={StaticResource UpdateVisibilityConverter}}" />
            <WrapPanel Margin="0,8,0,0">
                <Button Content="{loc:Text Updates_Download}" Height="34" Margin="0,0,8,4"
                        Command="{Binding DownloadUpdateCommand}" Style="{StaticResource PrimaryButtonStyle}"
                        Visibility="{Binding ShowDownloadButton, Converter={StaticResource UpdateVisibilityConverter}}" />
                <Button Content="{loc:Text Updates_Restart}" Height="34" Margin="0,0,8,4"
                        Command="{Binding InstallUpdateCommand}" Style="{StaticResource PrimaryButtonStyle}"
                        Visibility="{Binding IsDownloaded, Converter={StaticResource UpdateVisibilityConverter}}" />
                <Button Content="{Binding DismissButtonText}" Height="34" Margin="0,0,8,4"
                        Command="{Binding LaterCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="{loc:Text Updates_ReleaseNotes}" Height="34" Margin="0,0,0,4"
                        Command="{Binding OpenReleasesCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
