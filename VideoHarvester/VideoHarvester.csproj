<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Version>0.6.0</Version>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationIcon>Images\icon.ico</ApplicationIcon>
        <StartupObject>VideoHarvester.Program</StartupObject>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Images\icon.ico" />
        <None Remove="Images\logo.png" />
        <Resource Include="Images\logo.png" />
        <None Remove="Images\splash.png" />
        <Resource Include="Images\splash.png" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <PackageReference Include="Velopack" Version="1.2.161" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <UpToDateCheckOutput Include="$(TargetDir)tools\yt-dlp.exe" />
        <UpToDateCheckOutput Include="$(TargetDir)tools\node.exe" />
        <UpToDateCheckOutput Include="$(TargetDir)tools\ffmpeg.exe" />
        <UpToDateCheckOutput Include="$(TargetDir)tools\ffprobe.exe" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="VideoHarvester.UnitTests" />
    </ItemGroup>

    <Target Name="InstallDevelopmentToolchain"
            AfterTargets="Build"
            Condition="'$(Configuration)' == 'Debug' and (!Exists('$(TargetDir)tools\yt-dlp.exe') or !Exists('$(TargetDir)tools\node.exe') or !Exists('$(TargetDir)tools\ffmpeg.exe') or !Exists('$(TargetDir)tools\ffprobe.exe'))">
        <Message Text="Installing the VideoHarvester development toolchain..." Importance="high" />
        <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\eng\Install-ReleaseToolchain.ps1&quot; -OutputDirectory &quot;$(TargetDir).&quot;" />
    </Target>

</Project>
